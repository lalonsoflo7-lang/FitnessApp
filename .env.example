# Copia este archivo a `.env.local` y rellena los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web).
# Estos valores identifican al proyecto; la seguridad real la dan las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desarrollo local contra el Firebase Emulator Suite (no requiere credenciales reales).
# Si es "true", las variables anteriores se ignoran y se usa el proyecto demo `demo-fitnessapp`.
VITE_USE_EMULATORS=false
